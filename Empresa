CREATE TABLE equipe (
    ID_EQUIPE INT AUTO_INCREMENT PRIMARY KEY,
    ID_FUNCIONARIOS INT,
    ID_PROJETOS INT,
    FUNCAO VARCHAR(180),
    FOREIGN KEY (ID_FUNCIONARIOS) REFERENCES Funcionarios(id),
    FOREIGN KEY (ID_PROJETOS) REFERENCES Projetos(id)
);

SELECT Departamentos.nome AS Departamento, COUNT(Funcionarios.id) AS Total_Funcionarios
FROM Funcionarios
INNER JOIN Departamentos
ON Funcionarios.Departamentos_id = Departamentos.id
GROUP BY Departamentos.nome;

