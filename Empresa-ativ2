--  1. Liste os 5 funcionários com maior salário.
SELECT *
FROM Funcionarios
ORDER BY salario DESC
LIMIT 5;

-- 2. Mostre os departamentos com mais de 3 funcionários.

SELECT Funcionarios, COUNT *  AS ‘Total_Funcionarios’
FROM departamento
INNER JOIN  funcionario_id on departamento_id
GROUP BY departamento_id
HAVING COUNT * > 3;

--  3. Liste os projetos com orçamento acima da média.

SELECT * FROM Projetos
WHERE orcamento . (SELECT AVG(orcamento) FROM Projetos);

-- 4. Mostre as tarefas pendentes com nomes dos funcionários e projetos. 

SELECT obrigacoes.DESCRICAO, tarefa.STATUS, Funcionarios.nome AS Funcionario
FROM obrigacoes
INNER JOIN Funcionarios ON obrigacoes.ID_FUNCIONARIO = Funcionarios.id
WHERE obrigacoes.STATUS = 'Pendente';



-- 5. Encontre os funcionários que não são 'Auxiliares' e ganham acima de R$ 4500. 


SELECT *
FROM Funcionarios
WHERE CARGO != ‘Auxiliar’ AND salario > 4500;


-- 6. Liste os nomes de funcionários com exatamente 4 letras usando LIKE com _.

SELECT nome 
FROM Funcionarios
WHERE nome LIKE ‘_INA’; 


-- 7. Exiba os funcionários com salário entre R$ 3500 e R$ 7000 e ordene por data de admissão.

SELECT *
FROM Funcionarios
WHERE salario BETWEEN 3500 AND 7000
ORDER BY data_admissao;

