-- 9. Mostre a soma de salários por departamento.


SELECT departamento_id, SUM (salario) AS total_salarios
FROM Funcionarios
GROUP BY departamento_id;



-- 10. Apresente o nome do projeto, nome do cliente e valor do contrato usando JOIN.

SELECT Proj.nome AS Projeto, Cli.nome AS cliente, Proj.valor_contrato
FROM Projetos
JOIN Clientes ON Proj.cliente_id = Cliente_id;


-- 11. Encontre os funcionários cujo salário é maior que a média salarial do próprio departamento.

SELECT  * FROM Funcionarios 
WHERE salario > (
SELECT AVG (salario > media) 
FROM Funcionarios);;

-- 12. Liste os nomes dos projetos com mais de duas tarefas associadas.

SELECT Proj.nome
FROM Projetos
JOIN obrigacoes ON Proj_id = obr_id
GROUP BY Proj.nome
HAVING COUNT(obr_id) > 2;

-- 13. Mostre todos os departamentos que não possuem funcionários associados (dica: LEFT JOIN).

SELECT  Funcionarios.nome, Departamentos.nome AS DEPARTAMENTO
FROM Funcionarios
LEFT JOIN departamento ON Funcionario.departamento_id = Departamento.departamento_id  WHERE Funcionario_id IS NULL;

-- 14. Crie uma consulta que mostre o nome dos funcionários, o nome do projeto e a descrição da tarefa atribuída a eles.

SELECT func.nome AS Funcionario, proj.nome AS projeto, obg.descricao
FROM Obrigacoes
JOIN Funcionario ON obg.funcionario_id = funcionario_id
JOIN projeto ON obg.projeto_id = projeto_id;


-- 15. Liste os clientes que contrataram projetos com valor total acima de R$ 50.000.

SELECT nome
FROM Clientes
JOIN Projetos ON Cliente_id = Proj.cliente_id
GROUP BY nome
HAVING SUM(Proj.valor) > 50000;
